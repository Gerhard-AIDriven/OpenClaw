# Cloudflare Pages redirects configuration
# CRITICAL: Must serve .html files directly, NOT rewrite to index.html

# Rule 1: Serve all .html files directly (reports, etc.)
/*.html    /*.html    200

# Rule 2: Reports directory - serve as-is
/reports/*    /reports/:splat    200

# Rule 3: API endpoints - pass through
/api/*    /api/:splat    200

# Rule 4: Existing files should be served directly
# (This prevents rewriting real files to index.html)

# DO NOT add catch-all rewrite to index.html
# Cloudflare Pages serves static files automatically
