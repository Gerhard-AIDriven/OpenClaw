.nav-link:hover, .nav-link:focus { text-decoration: none; }

.nav-link.disabled { color: rgb(145, 145, 145); pointer-events: none; cursor: default; }

.nav-tabs { border-bottom: 1px solid rgb(199, 199, 199); }

.nav-tabs .nav-link { margin-bottom: -1px; background-color: rgba(0, 0, 0, 0); border: 1px solid rgba(0, 0, 0, 0); border-top-left-radius: 0.25rem; border-top-right-radius: 0.25rem; }

.nav-tabs .nav-link:hover, .nav-tabs .nav-link:focus { isolation: isolate; border-color: rgb(217, 217, 217) rgb(217, 217, 217) rgb(199, 199, 199); }

.nav-tabs .nav-link.disabled { color: rgb(145, 145, 145); background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); }

.nav-tabs .nav-link.active, .nav-tabs .nav-item.show .nav-link { color: rgb(128, 128, 128); background-color: rgb(255, 255, 255); border-color: rgb(199, 199, 199) rgb(199, 199, 199) rgb(255, 255, 255); }

.nav-tabs .dropdown-menu { margin-top: -1px; border-top-left-radius: 0px; border-top-right-radius: 0px; }

.nav-pills .nav-link { background: none; border: 0px; border-radius: 0.25rem; }

.nav-pills .nav-link.active, .nav-pills .show > .nav-link { color: rgb(255, 255, 255); background-color: rgb(32, 74, 212); }

.nav-fill > .nav-link, .nav-fill .nav-item { flex: 1 1 auto; text-align: center; }

.nav-justified > .nav-link, .nav-justified .nav-item { flex-basis: 0px; flex-grow: 1; text-align: center; }

.tab-content > .tab-pane { display: none; }

.tab-content > .active { display: block; }

