@charset "utf-8";

.brand { --brand-max-height: 60px; }

@media (max-width: 1279.98px) {
  .brand { --brand-max-height: 56px; }
}

@media (max-width: 767.98px) {
  .brand { --brand-max-height: 42px; }
}

.brand > a[href]:focus-visible { outline: 3px solid var(--a11y-focus-color,#E31CEE); outline-offset: -3px; }

@media (hover: hover) {
  .brand > a[href]:hover, .brand > a[href]:active { outline: none; }
}

.brand > a[href] { display: block; outline: none; color: currentcolor; }

.brand > a[href]:focus-visible { background-color: rgba(227, 28, 238, 0.1); }

.brand img { max-height: var(--brand-max-height,64px); width: auto; vertical-align: top; }

.brand--au-govt { margin-inline-start: auto; display: none; }

@media (min-width: 768px) {
  .brand--au-govt { display: block; }
}

@media (min-width: 1024px) {
  .brand--au-govt { margin-inline-start: 1.5rem; }
}

.brand--linz-alt { margin-inline-start: auto; }

@media (min-width: 1024px) {
  .brand--linz-alt { margin-inline-start: auto; }
  .brand--linz-alt img { transform: scale(0.8) translateY(6px); }
}

.page-node-type-marketing-landing-page .region-header { padding-block: 0px; }

@media (width >= 1024px) {
  .page-node-type-marketing-landing-page .region-header { padding-block-start: 0px; }
}

.page-node-type-marketing-landing-page .region-header:has(.brand img) { padding-block: calc(var(--spacer)*3); }

@media (min-width: 1024px) {
  .page-node-type-marketing-landing-page .region-header:has(.brand img) { padding-block-end: 0px; }
}

.region-header > .brand:not(:has(img)) { --linz-menu-top-level-link-mb: 0; }

@media screen {
  .menu__mega-menu { --mega-menu-dropdown-bg: var(--linz-teal-100); }
  @media screen and (forced-colors: active) {
  .menu__mega-menu { border-bottom: 1px solid rgb(255, 255, 255); border-top: 1px solid rgb(255, 255, 255); }
}
  @media (-ms-high-contrast:active) {
  .menu__mega-menu { border-bottom: 1px solid rgb(255, 255, 255); border-top: 1px solid rgb(255, 255, 255); }
}
  @media (min-width: 1024px) {
  .menu__mega-menu { box-shadow: rgba(0, 0, 0, 0.05) 0px 10px 5px -5px; --mega-menu-dropdown-left: 0; --mega-menu-dropdown-top: var(--min-height,inherit); --mega-menu-dropdown-position: absolute; top: var(--mega-menu-top-offset); }
}
  .menu__mega-menu[data-state="open"] { opacity: 1; }
